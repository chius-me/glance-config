# Copy to .env and fill in your values
# ---------- Proxy ----------
# HTTP_PROXY=http://user:password@your-proxy-host:7890
# HTTPS_PROXY=http://user:password@your-proxy-host:7890
# NO_PROXY=localhost,127.0.0.1,10.0.0.0/8,192.168.0.0/16,172.16.0.0/12

# ---------- Jellyfin ----------
JELLYFIN_URL=http://your-jellyfin-host:8096
JELLYFIN_KEY=your_jellyfin_api_key

# ---------- Duolingo ----------
DUO_USER_ID=your_duolingo_user_id
DUO_JWT_TOKEN=your_duolingo_jwt_token

# ---------- Cloudflare ----------
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_TUNNEL_ID=your_cloudflare_tunnel_id
CLOUDFLARE_API_KEY=your_cloudflare_api_key

# ---------- TrueNAS ----------
TRUENAS_API_KEY=your_truenas_api_key

# ---------- Proxmox ----------
PROXMOXVE_KEY=root@pam!your_token_id=your_token_secret

# ---------- Minecraft ----------
MC_SERVER_URL=your-minecraft-server:25565

# ---------- Steam ----------
STEAM_API_KEY=your_steam_api_key
STEAM_USER_IDS=your_steam_user_ids
STEAM_USER=your_steam_user_id

# ---------- Netbird ----------
NETBIRD_API_KEY=your_netbird_api_key

# ---------- Tailscale ----------
TAILSCALE_API_KEY=your_tailscale_api_key

# ---------- Komga ----------
KOMGA_API_KEY=your_komga_api_key
LIBRARY_ID=your_komga_library_id

# ---------- Last.FM ----------
LASTFM_USERNAME=your_lastfm_username
LASTFM_API_KEY=your_lastfm_api_key

# ---------- Syncthing ----------
SYNCTHING_URL=http://your-syncthing-host:8384
SYNCTHING_API_KEY=your_syncthing_api_key

# ---------- Immich ----------
IMMICH_URL=http://your-immich-host:2283
IMMICH_API_KEY=your_immich_api_key

# ---------- AdGuard ----------
ADGUARD_URL=http://your-adguard-host
ADGUARD_USERNAME=your_adguard_username
ADGUARD_PASSWORD=your_adguard_password

# ---------- HAProxy ----------
HAPROXY_MONITOR_URL=http://user:password@your-haproxy-host:8888/haproxy_stats

# ---------- NASA ----------
NASA_API_KEY=your_nasa_api_key
